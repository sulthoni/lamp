"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_city_en_City>\n  rml:logicalSource [ rml:source \"city_en.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/City/city_en/{cities/ID}\" ;\n    rr:class <http://example.com/City/cities/ID>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :cityid ;\n    rr:objectMap [\n      rml:reference \"cities/ID\" ;\n      rr:datatype xsd:integer\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :cityname ;\n    rr:objectMap [\n      rml:reference \"cities/Name\" ;\n      rr:datatype xsd:langString\n    ]  ] .\n\n"