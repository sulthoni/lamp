@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ex: <http://example.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <http://example.com/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@base <http://example.com/> .

<#LogicalTable_persons_Person>
  rml:logicalSource [ rml:source "persons.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/Person/persons/{persons/fname}" ;
    rr:class <http://example.com/Person/fname>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :firstname ;
    rr:objectMap [
      rml:reference "fname" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :lastname ;
    rr:objectMap [
      rml:reference "lname" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :owes ;
    rr:objectMap [
      rml:reference "amount" ;
      rr:datatype xsd:double
    ]  ] .