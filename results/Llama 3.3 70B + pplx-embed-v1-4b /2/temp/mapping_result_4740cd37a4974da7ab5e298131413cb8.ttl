"@prefix cc: <http://creativecommons.org/ns#> .\n@prefix dc: <http://purl.org/dc/terms/> .\n@prefix dct: <http://purl.org/dc/terms/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix adms: <http://www.w3.org/ns/adms#> .\n@prefix dcat: <http://www.w3.org/ns/dcat#> .\n@prefix foaf: <http://xmlns.com/foaf/0.1/> .\n@prefix gtfs: <http://vocab.gtfs.org/terms#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix vann: <http://purl.org/vocab/vann/> .\n@prefix schema: <http://schema.org/> .\n@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .\n@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://vocab.gtfs.org/terms#> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://vocab.gtfs.org/terms#> .\n\n<#LogicalTable_agency_Agency>\n  rml:logicalSource [ rml:source \"agency.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Agency/agency/{agency_id}\" ;\n    rr:class <http://example.com/Agency/agency_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"agency identifier\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Name ;\n    rr:objectMap [\n      rml:reference \"name of agency\" ;\n      rr:datatype xsd:name\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"agency website url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Timezone ;\n    rr:objectMap [\n      rml:reference \"agency timezone\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Language ;\n    rr:objectMap [\n      rml:reference \"agency language\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :PhoneNumber ;\n    rr:objectMap [\n      rml:reference \"agency phone number\" ;\n      rr:datatype xsd:phone\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :fare URL ;\n    rr:objectMap [\n      rml:reference \"agency fare information url\" ;\n      rr:datatype xsd:page\n    ]  ] .\n\n\n<#LogicalTable_calendar_dates_CalendarDateRule>\n  rml:logicalSource [ rml:source \"calendar_dates.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#CalendarDateRule/calendar_dates/{service_id}\" ;\n    rr:class <http://example.com/CalendarDateRule/service_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Date ;\n    rr:objectMap [\n      rml:reference \"date of service\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Exception Type ;\n    rr:objectMap [\n      rml:reference \"type of exception\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_calendar_CalendarRule>\n  rml:logicalSource [ rml:source \"calendar.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#CalendarRule/calendar/{service_id}\" ;\n    rr:class <http://example.com/CalendarRule/service_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :StartDate ;\n    rr:objectMap [\n      rml:reference \"start date of service\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :EndDate ;\n    rr:objectMap [\n      rml:reference \"end date of service\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_feed_info_GTFS_Feed>\n  rml:logicalSource [ rml:source \"feed_info.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#GTFS_Feed/feed_info/{feed_publisher_name}\" ;\n    rr:class <http://example.com/GTFS Feed/feed_version>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Publisher ;\n    rr:objectMap [\n      rml:reference \"name of feed publisher\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"URL of feed publisher\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Language ;\n    rr:objectMap [\n      rml:reference \"language of feed\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :StartDate ;\n    rr:objectMap [\n      rml:reference \"start date of feed\" ;\n      rr:datatype xsd:startDate\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :EndDate ;\n    rr:objectMap [\n      rml:reference \"end date of feed\" ;\n      rr:datatype xsd:endDate\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Version ;\n    rr:objectMap [\n      rml:reference \"version of feed\" ;\n      rr:datatype xsd:version\n    ]  ] .\n\n\n<#LogicalTable_frequencies_Frequency>\n  rml:logicalSource [ rml:source \"frequencies.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Frequency/frequencies/{trip_id}\" ;\n    rr:class <http://example.com/Frequency/trip_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Trip/{trip identifier}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Trip>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Start Time ;\n    rr:objectMap [\n      rml:reference \"start time of trip\" ;\n      rr:datatype xsd:startTime\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :End Time ;\n    rr:objectMap [\n      rml:reference \"end time of trip\" ;\n      rr:datatype xsd:endTime\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Headway Seconds ;\n    rr:objectMap [\n      rml:reference \"time interval between trips in seconds\" ;\n      rr:datatype xsd:positiveInteger\n    ]  ] .\n\n\n<#LogicalTable_routes_Route>\n  rml:logicalSource [ rml:source \"routes.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Route/routes/{route_id}\" ;\n    rr:class <http://example.com/Route/route_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"unique route identifier\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :agency ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Agency/{transportation agency identifier}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Agency>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Short name ;\n    rr:objectMap [\n      rml:reference \"short name of the route\" ;\n      rr:datatype xsd:n3-275\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Long name ;\n    rr:objectMap [\n      rml:reference \"full name of the route\" ;\n      rr:datatype xsd:n3-272\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :RouteDesc ;\n    rr:objectMap [\n      rml:reference \"description of the route\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Route type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-186/{type of transportation route}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-186>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"uniform resource locator for the route\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Color ;\n    rr:objectMap [\n      rml:reference \"color associated with the route\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Text color ;\n    rr:objectMap [\n      rml:reference \"text color used for the route\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_shapes_ShapePoint>\n  rml:logicalSource [ rml:source \"shapes.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#ShapePoint/shapes/{shape_id}\" ;\n    rr:class <http://example.com/ShapePoint/shape_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"shape_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Latitude ;\n    rr:objectMap [\n      rml:reference \"shape_pt_lat\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Longitude ;\n    rr:objectMap [\n      rml:reference \"shape_pt_lon\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Point Sequence ;\n    rr:objectMap [\n      rml:reference \"shape_pt_sequence\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Distance Traveled ;\n    rr:objectMap [\n      rml:reference \"shape_dist_traveled\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_stop_times_StopTime>\n  rml:logicalSource [ rml:source \"stop_times.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#StopTime/stop_times/{trip_id}\" ;\n    rr:class <http://example.com/StopTime/stop_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{trip_id}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Arrival time ;\n    rr:objectMap [\n      rml:reference \"arrival_time\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Departure time ;\n    rr:objectMap [\n      rml:reference \"departure_time\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Stop ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{stop_id}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Pickup type ;\n    rr:objectMap [\n      rml:reference \"pickup_type\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Drop off type ;\n    rr:objectMap [\n      rml:reference \"drop_off_type\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Distance Traveled ;\n    rr:objectMap [\n      rml:reference \"shape_dist_traveled\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_stops_Stop>\n  rml:logicalSource [ rml:source \"stops.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Stop/stops/{stop_id}\" ;\n    rr:class <http://example.com/Stop/stop_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"stop_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Location Code ;\n    rr:objectMap [\n      rml:reference \"stop_code\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Name ;\n    rr:objectMap [\n      rml:reference \"stop_name\" ;\n      rr:datatype xsd:name\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :RouteDesc ;\n    rr:objectMap [\n      rml:reference \"stop_desc\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Latitude ;\n    rr:objectMap [\n      rml:reference \"stop_lat\" ;\n      rr:datatype xsd:lat\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Longitude ;\n    rr:objectMap [\n      rml:reference \"stop_lon\" ;\n      rr:datatype xsd:long\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"stop_url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Location Type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-229/{location_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-229>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Parent Station ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Station/{parent_station}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Station>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Timezone ;\n    rr:objectMap [\n      rml:reference \"stop_timezone\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Wheelchair accesible ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-238/{wheelchair_boarding}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-238>\n    ]\n  ] .\n\n\n<#LogicalTable_trips_Trip>\n  rml:logicalSource [ rml:source \"trips.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Trip/trips/{route_id}\" ;\n    rr:class <http://example.com/Trip/trip_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"trip_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Headsign ;\n    rr:objectMap [\n      rml:reference \"trip_headsign\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Short name ;\n    rr:objectMap [\n      rml:reference \"trip_short_name\" ;\n      rr:datatype xsd:n3-275\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Route ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Route/{route_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Route>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Service ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Service/{service_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Service>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Shape ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Shape/{shape_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Shape>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Wheelchair accesible ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-238/{wheelchair_accessible}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-238>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Direction ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-246/{direction_id}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-246>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Block ;\n    rr:objectMap [\n      rml:reference \"block_id\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n"