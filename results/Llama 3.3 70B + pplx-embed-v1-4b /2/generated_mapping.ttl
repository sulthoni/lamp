    rr:predicate :Version ;
    rr:objectMap [
      rml:reference "version of feed" ;
      rr:datatype xsd:version
    ]  ] .


<#LogicalTable_frequencies_Frequency>
  rml:logicalSource [ rml:source "frequencies.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://vocab.gtfs.org/terms#Frequency/frequencies/{trip_id}" ;
    rr:class <http://example.com/Frequency/trip_id>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :Trip ;
    rr:objectMap [
      rr:template "http://vocab.gtfs.org/terms#Trip/{trip identifier}" ;
      rr:class <http://vocab.gtfs.org/terms#Trip>
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate :Start Time ;
    rr:objectMap [
      rml:reference "start time of trip" ;
      rr:datatype xsd:startTime
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :End Time ;
    rr:objectMap [
      rml:reference "end time of trip" ;
      rr:datatype xsd:endTime
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Headway Seconds ;
    rr:objectMap [
      rml:reference "time interval between trips in seconds" ;
      rr:datatype xsd:positiveInteger
    ]  ] .


<#LogicalTable_routes_Route>
  rml:logicalSource [ rml:source "routes.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://vocab.gtfs.org/terms#Route/routes/{route_id}" ;
    rr:class <http://example.com/Route/route_id>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :ID ;
    rr:objectMap [
      rml:reference "unique route identifier" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :agency ;
    rr:objectMap [
      rr:template "http://vocab.gtfs.org/terms#Agency/{transportation agency identifier}" ;
      rr:class <http://vocab.gtfs.org/terms#Agency>
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate :Short name ;
    rr:objectMap [
      rml:reference "short name of the route" ;
      rr:datatype xsd:n3-275
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Long name ;
    rr:objectMap [
      rml:reference "full name of the route" ;
      rr:datatype xsd:n3-272
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :RouteDesc ;
    rr:objectMap [
      rml:reference "description of the route" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Route type ;
    rr:objectMap [
      rr:template "http://vocab.gtfs.org/terms#Concept, n3-186/{type of transportation route}" ;
      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-186>
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate :URL ;
    rr:objectMap [
      rml:reference "uniform resource locator for the route" ;
      rr:datatype xsd:page
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Color ;
    rr:objectMap [
      rml:reference "color associated with the route" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Text color ;
    rr:objectMap [
      rml:reference "text color used for the route" ;
      rr:datatype xsd:string
    ]  ] .


