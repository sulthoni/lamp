@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gtfs: <http://vocab.gtfs.org/terms#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <http://schema.org/> .
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <http://vocab.gtfs.org/terms#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@base <http://vocab.gtfs.org/terms#> .

<#LogicalTable_agency_Agency>
  rml:logicalSource [ rml:source "agency.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://vocab.gtfs.org/terms#Agency/agency/{agency_id}" ;
    rr:class <http://example.com/Agency/agency_id>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :ID ;
    rr:objectMap [
      rml:reference "agency identifier" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Name ;
    rr:objectMap [
      rml:reference "name of agency" ;
      rr:datatype xsd:name
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :URL ;
    rr:objectMap [
      rml:reference "agency website url" ;
      rr:datatype xsd:page
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Timezone ;
    rr:objectMap [
      rml:reference "agency timezone" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Language ;
    rr:objectMap [
      rml:reference "agency language" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :PhoneNumber ;
    rr:objectMap [
      rml:reference "agency phone number" ;
      rr:datatype xsd:phone
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :fare URL ;
    rr:objectMap [
      rml:reference "agency fare information url" ;
      rr:datatype xsd:page
    ]  ] .


