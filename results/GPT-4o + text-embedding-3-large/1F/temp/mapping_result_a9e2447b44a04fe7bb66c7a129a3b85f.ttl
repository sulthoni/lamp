"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_sport_Sport>\n  rml:logicalSource [ rml:source \"sport.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Sport/sport/{sports/ID}\" ;\n    rr:class <http://example.com/Sport/sports/ID>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :sportid ;\n    rr:objectMap [\n      rml:reference \"sports/ID\" ;\n      rr:datatype xsd:integer\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :sportname ;\n    rr:objectMap [\n      rml:reference \"sports/Description\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_student_sport_Person>\n  rml:logicalSource [ rml:source \"student_sport.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/student_sport/{links/ID_Student}\" ;\n    rr:class <http://example.com/Person/links/ID_Student>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :practises ;\n    rr:objectMap [\n      rr:template \"http://example.com/Sport/{links/ID_Student}\" ;\n      rr:class <http://example.org/Sport>\n    ]\n  ] .\n\n\n<#LogicalTable_student_sport_Sport>\n  rml:logicalSource [ rml:source \"student_sport.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Sport/student_sport/{links/ID_Student}\" ;\n    rr:class <http://example.com/Sport/links/ID_Sport>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :practises ;\n    rr:objectMap [\n      rr:template \"http://example.com/Sport/{links/ID_Sport}\" ;\n      rr:class <http://example.org/Sport>\n    ]\n  ] .\n\n\n<#LogicalTable_student_Person>\n  rml:logicalSource [ rml:source \"student.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/student/{students/ID}\" ;\n    rr:class <http://example.com/Person/students/ID>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :id ;\n    rr:objectMap [\n      rml:reference \"students/ID\" ;\n      rr:datatype xsd:integer\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :firstname ;\n    rr:objectMap [\n      rml:reference \"students/FirstName\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :lastname ;\n    rr:objectMap [\n      rml:reference \"students/LastName\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n"