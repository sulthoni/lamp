"@prefix cc: <http://creativecommons.org/ns#> .\n@prefix dc: <http://purl.org/dc/terms/> .\n@prefix dct: <http://purl.org/dc/terms/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix adms: <http://www.w3.org/ns/adms#> .\n@prefix dcat: <http://www.w3.org/ns/dcat#> .\n@prefix foaf: <http://xmlns.com/foaf/0.1/> .\n@prefix gtfs: <http://vocab.gtfs.org/terms#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix vann: <http://purl.org/vocab/vann/> .\n@prefix schema: <http://schema.org/> .\n@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .\n@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://vocab.gtfs.org/terms#> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://vocab.gtfs.org/terms#> .\n\n<#LogicalTable_agency_Agency>\n  rml:logicalSource [ rml:source \"agency.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Agency/agency/{agency_id}\" ;\n    rr:class <http://example.com/Agency/agency_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"agency_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Name ;\n    rr:objectMap [\n      rml:reference \"agency_name\" ;\n      rr:datatype xsd:name\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"agency_url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Timezone ;\n    rr:objectMap [\n      rml:reference \"agency_timezone\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Language ;\n    rr:objectMap [\n      rml:reference \"agency_lang\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :PhoneNumber ;\n    rr:objectMap [\n      rml:reference \"agency_phone\" ;\n      rr:datatype xsd:phone\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :fare URL ;\n    rr:objectMap [\n      rml:reference \"agency_fare_url\" ;\n      rr:datatype xsd:page\n    ]  ] .\n\n\n<#LogicalTable_calendar_dates_Calendar_date_rule>\n  rml:logicalSource [ rml:source \"calendar_dates.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Calendar_date_rule/calendar_dates/{service_id}\" ;\n    rr:class <http://example.com/Calendar_date_rule/service_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Date ;\n    rr:objectMap [\n      rml:reference \"date\" ;\n      rr:datatype xsd:date\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Exception Type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-221/{exception_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-221>\n    ]\n  ] .\n\n\n<#LogicalTable_calendar_Calendar_rule>\n  rml:logicalSource [ rml:source \"calendar.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Calendar_rule/calendar/{service_id}\" ;\n    rr:class <http://example.com/Calendar_rule/service_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Monday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-193/{monday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-193>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Tuesday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-197/{tuesday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-197>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Wednesday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-201/{wednesday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-201>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Thursday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-205/{thursday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-205>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Friday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-209/{friday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-209>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Saturday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-213/{saturday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-213>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Sunday ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-217/{sunday}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-217>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :StartDate ;\n    rr:objectMap [\n      rml:reference \"start_date\" ;\n      rr:datatype xsd:startDate\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :EndDate ;\n    rr:objectMap [\n      rml:reference \"end_date\" ;\n      rr:datatype xsd:endDate\n    ]  ] .\n\n\n<#LogicalTable_feed_info_GTFS_Feed>\n  rml:logicalSource [ rml:source \"feed_info.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#GTFS_Feed/feed_info/{feed_publisher_name}\" ;\n    rr:class <http://example.com/GTFS_Feed/feed_publisher_name>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Publisher ;\n    rr:objectMap [\n      rml:reference \"feed_publisher_name\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"feed_publisher_url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Language ;\n    rr:objectMap [\n      rml:reference \"feed_lang\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :StartDate ;\n    rr:objectMap [\n      rml:reference \"feed_start_date\" ;\n      rr:datatype xsd:startDate\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :EndDate ;\n    rr:objectMap [\n      rml:reference \"feed_end_date\" ;\n      rr:datatype xsd:endDate\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Version ;\n    rr:objectMap [\n      rml:reference \"feed_version\" ;\n      rr:datatype xsd:version\n    ]  ] .\n\n\n<#LogicalTable_frequencies_Frequency>\n  rml:logicalSource [ rml:source \"frequencies.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Frequency/frequencies/{trip_id}\" ;\n    rr:class <http://example.com/Frequency/trip_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Trip/{trip_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Trip>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Start Time ;\n    rr:objectMap [\n      rml:reference \"start_time\" ;\n      rr:datatype xsd:startTime\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :End Time ;\n    rr:objectMap [\n      rml:reference \"end_time\" ;\n      rr:datatype xsd:endTime\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Headway Seconds ;\n    rr:objectMap [\n      rml:reference \"headway_secs\" ;\n      rr:datatype xsd:positiveInteger\n    ]  ] .\n\n\n<#LogicalTable_routes_Route>\n  rml:logicalSource [ rml:source \"routes.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Route/routes/{route_id}\" ;\n    rr:class <http://example.com/Route/route_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"route_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Short name ;\n    rr:objectMap [\n      rml:reference \"route_short_name\" ;\n      rr:datatype xsd:n3-275\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Long name ;\n    rr:objectMap [\n      rml:reference \"route_long_name\" ;\n      rr:datatype xsd:n3-272\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :RouteDesc ;\n    rr:objectMap [\n      rml:reference \"route_desc\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"route_url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Color ;\n    rr:objectMap [\n      rml:reference \"route_color\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Text color ;\n    rr:objectMap [\n      rml:reference \"route_text_color\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :agency ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Agency/{agency_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Agency>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Route type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-186/{route_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-186>\n    ]\n  ] .\n\n\n<#LogicalTable_shapes_Shape>\n  rml:logicalSource [ rml:source \"shapes.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Shape/shapes/{shape_id}\" ;\n    rr:class <http://example.com/Shape/shape_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"shape_id\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_shapes_Shape_Point>\n  rml:logicalSource [ rml:source \"shapes.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Shape_Point/shapes/{shape_id}\" ;\n    rr:class <http://example.com/ShapePoint/shape_pt_sequence>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Latitude ;\n    rr:objectMap [\n      rml:reference \"shape_pt_lat\" ;\n      rr:datatype xsd:lat\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Longitude ;\n    rr:objectMap [\n      rml:reference \"shape_pt_lon\" ;\n      rr:datatype xsd:long\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Point Sequence ;\n    rr:objectMap [\n      rml:reference \"shape_pt_sequence\" ;\n      rr:datatype xsd:nonNegativeInteger\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Distance Traveled ;\n    rr:objectMap [\n      rml:reference \"shape_dist_traveled\" ;\n      rr:datatype xsd:nonNegativeFloat\n    ]  ] .\n\n\n<#LogicalTable_stop_times_Stop_time>\n  rml:logicalSource [ rml:source \"stop_times.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Stop_time/stop_times/{trip_id}\" ;\n    rr:class <http://example.com/Stop_time/trip_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Trip/{trip_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Trip>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Arrival time ;\n    rr:objectMap [\n      rml:reference \"arrival_time\" ;\n      rr:datatype xsd:Time\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Departure time ;\n    rr:objectMap [\n      rml:reference \"departure_time\" ;\n      rr:datatype xsd:Time\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Stop ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Stop/{stop_id}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Stop>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Stop sequence ;\n    rr:objectMap [\n      rml:reference \"stop_sequence\" ;\n      rr:datatype xsd:nonNegativeInteger\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Headsign ;\n    rr:objectMap [\n      rml:reference \"stop_headsign\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Pickup type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-182/{pickup_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-182>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Drop off type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-173/{drop_off_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-173>\n    ]\n  ] .\n\n\n<#LogicalTable_stops_Stop>\n  rml:logicalSource [ rml:source \"stops.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Stop/stops/{stop_id}\" ;\n    rr:class <http://example.com/Stop/stop_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :ID ;\n    rr:objectMap [\n      rml:reference \"stop_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Name ;\n    rr:objectMap [\n      rml:reference \"stop_name\" ;\n      rr:datatype xsd:name\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Latitude ;\n    rr:objectMap [\n      rml:reference \"stop_lat\" ;\n      rr:datatype xsd:lat\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Longitude ;\n    rr:objectMap [\n      rml:reference \"stop_lon\" ;\n      rr:datatype xsd:long\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :URL ;\n    rr:objectMap [\n      rml:reference \"stop_url\" ;\n      rr:datatype xsd:page\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Location Type ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-229/{location_type}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-229>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Parent Station ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Station/{parent_station}\" ;\n      rr:class <http://vocab.gtfs.org/terms#Station>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Wheelchair accesible ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#Concept, n3-238/{wheelchair_boarding}\" ;\n      rr:class <http://www.w3.org/2004/02/skos/core#Concept, n3-238>\n    ]\n  ] .\n\n\n<#LogicalTable_trips_Trip>\n  rml:logicalSource [ rml:source \"trips.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://vocab.gtfs.org/terms#Trip/trips/{route_id}\" ;\n    rr:class <http://example.com/Trip/trip_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.ID ;\n    rr:objectMap [\n      rml:reference \"trip_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Headsign ;\n    rr:objectMap [\n      rml:reference \"trip_headsign\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Short name ;\n    rr:objectMap [\n      rml:reference \"trip_short_name\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Direction ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{direction_id}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Block ;\n    rr:objectMap [\n      rml:reference \"block_id\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Wheelchair accesible ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{wheelchair_accessible}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Route ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{route_id}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Service ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{service_id}\" ;\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Trip.Shape ;\n    rr:objectMap [\n      rr:template \"http://vocab.gtfs.org/terms#None/{shape_id}\" ;\n    ]\n  ] .\n\n"