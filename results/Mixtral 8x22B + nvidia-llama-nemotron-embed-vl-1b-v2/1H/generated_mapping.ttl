@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ex: <http://example.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <http://example.com/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@base <http://example.com/> .

<#LogicalTable_city_en_City>
  rml:logicalSource [ rml:source "city_en.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/City/city_en/{cities/ID}" ;
    rr:class <http://example.com/City/cities/ID>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :cityid ;
    rr:objectMap [
      rml:reference "cities/ID" ;
      rr:datatype xsd:integer
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :cityname ;
    rr:objectMap [
      rml:reference "cities/Name" ;
      rr:datatype xsd:langString
    ]  ] .


<#LogicalTable_city_es_City>
  rml:logicalSource [ rml:source "city_es.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/City/city_es/{cities/ID}" ;
    rr:class <http://example.com/City/cities/ID>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :cityid ;
    rr:objectMap [
      rml:reference "cities/ID" ;
      rr:datatype xsd:integer
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :cityname ;
    rr:objectMap [
      rml:reference "cities/Name" ;
      rr:datatype xsd:langString
    ]  ] .