@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ex: <http://example.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <http://example.com/> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@base <http://example.com/> .

<#LogicalTable_sport_Sport>
  rml:logicalSource [ rml:source "sport.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/Sport/sport/{sports/ID}" ;
    rr:class <http://example.com/Sport/sports/ID>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :sportid ;
    rr:objectMap [
      rml:reference "sports/ID" ;
      rr:datatype xsd:integer
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :sportname ;
    rr:objectMap [
      rml:reference "sports/Description" ;
      rr:datatype xsd:string
    ]  ] .


<#LogicalTable_student_sport_Person>
  rml:logicalSource [ rml:source "student_sport.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/Person/student_sport/{links/ID_Student}" ;
    rr:class <http://example.com/Person/ID_Student>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :practises ;
    rr:objectMap [
      rr:template "http://example.com/Sport/{links/ID_Student}" ;
      rr:class <http://example.org/Sport>
    ]
  ] .


<#LogicalTable_student_sport_Sport>
  rml:logicalSource [ rml:source "student_sport.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/Sport/student_sport/{links/ID_Student}" ;
    rr:class <http://example.com/Sport/ID_Sport>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :practisedBy ;
    rr:objectMap [
      rr:template "http://example.com/None/{links/ID_Sport}" ;
    ]
  ] .


<#LogicalTable_student_Person>
  rml:logicalSource [ rml:source "student.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://example.com/Person/student/{students/ID}" ;
    rr:class <http://example.com/Person/students/ID>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :id ;
    rr:objectMap [
      rml:reference "students/ID" ;
      rr:datatype xsd:integer
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :firstname ;
    rr:objectMap [
      rml:reference "students/FirstName" ;
      rr:datatype xsd:string
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :lastname ;
    rr:objectMap [
      rml:reference "students/LastName" ;
      rr:datatype xsd:string
    ]  ] .