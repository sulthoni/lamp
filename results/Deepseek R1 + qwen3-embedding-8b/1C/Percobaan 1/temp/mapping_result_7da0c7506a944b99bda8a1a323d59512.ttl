"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_student_sport_Person>\n  rml:logicalSource [ rml:source \"student_sport.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/student_sport/{students/Student}\" ;\n    rr:class <http://example.com/Person/students/Student>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :fullname ;\n    rr:objectMap [\n      rml:reference \"students/Student\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n\n<#LogicalTable_student_sport_Sport>\n  rml:logicalSource [ rml:source \"student_sport.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Sport/student_sport/{students/Student}\" ;\n    rr:class <http://example.com/Sport/students/Sport>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :sportname ;\n    rr:objectMap [\n      rml:reference \"students/Sport\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n"