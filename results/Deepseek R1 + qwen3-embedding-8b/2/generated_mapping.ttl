      rml:reference "shape_pt_lat" ;
      rr:datatype xsd:lat
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Longitude ;
    rr:objectMap [
      rml:reference "shape_pt_lon" ;
      rr:datatype xsd:long
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Point Sequence ;
    rr:objectMap [
      rml:reference "shape_pt_sequence" ;
      rr:datatype xsd:nonNegativeInteger
    ]  ] ;

  rr:predicateObjectMap [
    rr:predicate :Distance Traveled ;
    rr:objectMap [
      rml:reference "shape_dist_traveled" ;
      rr:datatype xsd:nonNegativeFloat
    ]  ] .


