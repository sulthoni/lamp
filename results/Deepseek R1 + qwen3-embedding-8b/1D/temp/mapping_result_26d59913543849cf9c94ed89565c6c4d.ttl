"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_ious_Person>\n  rml:logicalSource [ rml:source \"ious.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/ious/{persons/fname}\" ;\n    rr:class <http://example.com/Person/persons/fname>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :firstname ;\n    rr:objectMap [\n      rml:reference \"persons/fname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :lastname ;\n    rr:objectMap [\n      rml:reference \"persons/lname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :owes ;\n    rr:objectMap [\n      rml:reference \"persons/amount\" ;\n      rr:datatype xsd:double\n    ]  ] .\n\n"