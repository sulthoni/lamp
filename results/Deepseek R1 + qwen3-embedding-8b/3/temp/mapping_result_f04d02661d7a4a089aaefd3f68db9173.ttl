"@prefix cc: <http://creativecommons.org/ns#> .\n@prefix dc: <http://purl.org/dc/elements/1.1/> .\n@prefix org: <http://www.w3.org/ns/org#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix foaf: <http://xmlns.com/foaf/0.1/> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix time: <http://www.w3.org/2006/time#> .\n@prefix vann: <http://purl.org/vocab/vann/> .\n@prefix schema: <https://schema.org/> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://data.europa.eu/a4g/ontology#> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://data.europa.eu/a4g/ontology#> .\n\n<#LogicalTable_Contracts_Document>\n  rml:logicalSource [ rml:source \"Contracts.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://data.europa.eu/a4g/ontology#Document/Contracts/{contract_id}\" ;\n    rr:class <http://example.com/Document/contract_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Has i d ;\n    rr:objectMap [\n      rr:template \"http://data.europa.eu/a4g/ontology#Identifier/{contract_id}\" ;\n      rr:class <http://data.europa.eu/a4g/ontology#Identifier>\n    ]\n  ] .\n\n\n<#LogicalTable_Parent Organizations_Organization>\n  rml:logicalSource [ rml:source \"Parent Organizations.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://data.europa.eu/a4g/ontology#Organization/Parent Organizations/{parent_id}\" ;\n    rr:class <http://example.com/Organization/parent_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Has i d ;\n    rr:objectMap [\n      rr:template \"http://data.europa.eu/a4g/ontology#Identifier/{parent_id}\" ;\n      rr:class <http://data.europa.eu/a4g/ontology#Identifier>\n    ]\n  ] .\n\n\n<#LogicalTable_Tender Results_Submission_statistical_information>\n  rml:logicalSource [ rml:source \"Tender Results.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://data.europa.eu/a4g/ontology#Submission_statistical_information/Tender Results/{result_id}\" ;\n    rr:class <http://example.com/Submission statistical information/result_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Has received tenders ;\n    rr:objectMap [\n      rml:reference \"received_tender_quantity\" ;\n      rr:datatype xsd:integer\n    ]  ] .\n\n\n<#LogicalTable_Valid Notices_Result_notice>\n  rml:logicalSource [ rml:source \"Valid Notices.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://data.europa.eu/a4g/ontology#Result_notice/Valid Notices/{notice_id}\" ;\n    rr:class <http://example.com/Result notice/notice_id>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Has i d ;\n    rr:objectMap [\n      rr:template \"http://data.europa.eu/a4g/ontology#Identifier/{notice_id}\" ;\n      rr:class <http://data.europa.eu/a4g/ontology#Identifier>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Refer to procedure ;\n    rr:objectMap [\n      rr:template \"http://data.europa.eu/a4g/ontology#Procedure/{contract_id}\" ;\n      rr:class <http://data.europa.eu/a4g/ontology#Procedure>\n    ]\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :Has dispatch date ;\n    rr:objectMap [\n      rml:reference \"issue_date\" ;\n      rr:datatype xsd:dateTime\n    ]  ] .\n\n"