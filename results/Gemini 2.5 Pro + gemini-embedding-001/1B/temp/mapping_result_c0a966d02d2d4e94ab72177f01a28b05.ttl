"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_student_Person>\n  rml:logicalSource [ rml:source \"student.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/student/{students/ID}\" ;\n    rr:class <http://example.com/Person/students/ID>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :id ;\n    rr:objectMap [\n      rml:reference \"students/ID\" ;\n      rr:datatype xsd:integer\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :fullname ;\n    rr:objectMap [\n      rml:reference \"students/Name\" ;\n      rr:datatype xsd:string\n    ]  ] .\n\n"