      rr:template "http://data.europa.eu/a4g/ontology#Identifier/{document_uri}" ;
      rr:class <http://data.europa.eu/a4g/ontology#Identifier>
    ]
  ] .


<#LogicalTable_Winning Party_Lot_award_outcome>
  rml:logicalSource [ rml:source "Winning Party.csv" ; rml:referenceFormulation ql:CSV ] ;

  rr:subjectMap [
    rr:template "http://data.europa.eu/a4g/ontology#Lot_award_outcome/Winning Party/{winning_party_id}" ;
    rr:class <http://example.com/Lot award outcome/winning_party_id>
  ] ;

  rr:predicateObjectMap [
    rr:predicate :Describes lot ;
    rr:objectMap [
      rr:template "http://data.europa.eu/a4g/ontology#Lot/{contract_id}" ;
      rr:class <http://data.europa.eu/a4g/ontology#Lot>
    ]
  ] .