"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix ex: <http://example.org/> .\n@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix : <http://example.com/> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@base <http://example.com/> .\n\n<#LogicalTable_lives_Person>\n  rml:logicalSource [ rml:source \"lives.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/lives/{lives/fname}\" ;\n    rr:class <http://example.com/Person/lives/fname>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :firstname ;\n    rr:objectMap [\n      rml:reference \"lives/fname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :lastname ;\n    rr:objectMap [\n      rml:reference \"lives/lname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :lives ;\n    rr:objectMap [\n      rr:template \"http://example.com/City/{lives/city}\" ;\n      rr:class <http://example.org/City>\n    ]\n  ] .\n\n\n<#LogicalTable_lives_City>\n  rml:logicalSource [ rml:source \"lives.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/City/lives/{lives/fname}\" ;\n    rr:class <http://example.com/City/lives/city>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :cityname ;\n    rr:objectMap [\n      rml:reference \"lives/city\" ;\n      rr:datatype xsd:langString\n    ]  ] .\n\n\n<#LogicalTable_persons_Person>\n  rml:logicalSource [ rml:source \"persons.csv\" ; rml:referenceFormulation ql:CSV ] ;\n\n  rr:subjectMap [\n    rr:template \"http://example.com/Person/persons/{persons/fname}\" ;\n    rr:class <http://example.com/Person/persons/fname>\n  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :firstname ;\n    rr:objectMap [\n      rml:reference \"persons/fname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :lastname ;\n    rr:objectMap [\n      rml:reference \"persons/lname\" ;\n      rr:datatype xsd:string\n    ]  ] ;\n\n  rr:predicateObjectMap [\n    rr:predicate :owes ;\n    rr:objectMap [\n      rml:reference \"persons/amount\" ;\n      rr:datatype xsd:double\n    ]  ] .\n\n"