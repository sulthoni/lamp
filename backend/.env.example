# ============================================================
# API Keys — fill in the key for your chosen LLM provider
# ============================================================
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama host (only needed when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# ============================================================
# GraphDB Configuration
# ============================================================
GRAPHDB_URL=http://localhost:7200

# ============================================================
# Vector Store / ChromaDB Configuration
# ============================================================
COLLECTION_NAME=ontology_collection_gemini_blinkg
CHROMADB_PATH=./data/chromadb/


# ─── LLM & Embedding Configuration ───────────────────────────────────────────
# Provider options: openai | gemini | anthropic | ollama
LLM_PROVIDER=openai
# LLM_PROVIDER=gemini

# OpenAI LLM models: chatgpt-4o-latest | gpt-4o | gpt-4o-mini | gpt-4-turbo | gpt-3.5-turbo
# Gemini LLM models: gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
# Anthropic LLM models: claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-3-5
# Ollama LLM models: any locally installed model name
# LLM_MODEL=gpt-4o
LLM_MODEL=gemini-2.5-flash

# OpenAI Embedding models: text-embedding-3-large | text-embedding-3-small | text-embedding-ada-002
# Gemini Embedding models: models/gemini-embedding-001 | models/text-embedding-004
# EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_MODEL=models/gemini-embedding-001

# Collection name should match the embedding model used to populate ChromaDB
# COLLECTION_NAME=schema_3_openai
COLLECTION_NAME=schema_1e
# ──────────────────────────────────────────────────────────────────────────────


# ============================================================
# Output & File Configuration
# ============================================================
SAVE_OUTPUT=False
SUGGESTED_TERMS_FILE=./data/suggested_terms.txt
TERMS_EMBEDDINGS_FILE=./data/embeddings.txt
TERMS_EMBEDDINGS_TABLE_FILE=./data/embeddings_table.txt
RETRIEVED_CANDIDATES_FILE=./data/retrieved_candidates.txt
RETRIEVED_CANDIDATES_TABLE_FILE=./data/retrieved_candidates_table.txt
RETRIEVED_CANDIDATES_LOG_FILE=./data/retrieved_candidates_log.txt
LLM_SELECTED_CONCEPTS_FILE=./data/llm_selected_concepts.txt
LLM_SELECTED_CONCEPTS_TABLE_FILE=./data/llm_selected_concepts_table.txt
LLM_SELECTED_CONCEPTS_LOG_FILE=./data/llm_selected_concepts_log.txt
SCHEMA_SUMMARY_FILE=./data/schema_summary.txt

# File / connections
CONNECTIONS_FILE=./data/connections.txt
TABLE_STRUCTURE_FILE=./data/table_structure.txt
ONTOLOGY_EXTRACT_FILE=./data/turtle-schema.json
LOCAL_ONTOLOGIES_FOLDER=./local_ontologies/
OUTPUT_JSON_FILE=./data/selected_candidates.json
CONCEPTS_OF_ONTOLOGY=./data/GSIM_Concept.csv

# ─── Prompt Logging Configuration ────────────────────────────────────────────
PROMPT_LOG_TERMS_FILE=./data/prompt_log_terms.txt
PROMPT_LOG_CONCEPTS_FILE=./data/prompt_log_concepts.txt
PROMPT_LOG_PROPERTIES_FILE=./data/prompt_log_properties.txt
# ──────────────────────────────────────────────────────────────────────────────
