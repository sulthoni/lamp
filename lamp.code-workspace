{
  "folders": [
    {
      "name": "Backend (Python/Flask)",
      "path": "./backend",
    },
    {
      "name": "Frontend (Angular)",
      "path": "./frontend",
    },
    {
      "name": "Root",
      "path": ".",
    },
  ],
  "settings": {
    // Python settings for backend
    "python.defaultInterpreterPath": "${workspaceFolder:Backend (Python/Flask)}/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.formatting.provider": "black",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": false,

    // TypeScript/Angular settings for frontend
    "typescript.tsdk": "${workspaceFolder:Frontend (Angular)}/node_modules/typescript/lib",
    "typescript.preferences.importModuleSpecifier": "relative",
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
      },
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },

    // General editor settings
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // File associations
    "files.associations": {
      "*.ttl": "turtle",
      "*.obda": "ini",
    },

    // Exclude patterns
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "**/.angular": true,
      "**/dist": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/dist": true,
      "**/.angular": true,
    },
  },
  "extensions": {
    "recommendations": [
      // Python extensions
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter",

      // Angular/TypeScript extensions
      "angular.ng-template",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",

      // General development
      "editorconfig.editorconfig",
      "eamodio.gitlens",

      // RDF/Ontology support
      "stardog-union.stardog-rdf-grammars",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Flask Backend",
        "type": "debugpy",
        "request": "launch",
        "module": "flask",
        "env": {
          "FLASK_APP": "app.py",
          "FLASK_ENV": "development",
          "FLASK_DEBUG": "1",
        },
        "args": ["run", "--port=5000"],
        "jinja": true,
        "cwd": "${workspaceFolder:Backend (Python/Flask)}",
      },
      {
        "name": "Angular: Chrome",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:4200",
        "webRoot": "${workspaceFolder:Frontend (Angular)}/src",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
          "webpack:/*": "${webRoot}/*",
        },
      },
    ],
    "compounds": [
      {
        "name": "Full Stack (Backend + Frontend)",
        "configurations": ["Python: Flask Backend", "Angular: Chrome"],
        "stopAll": true,
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Backend Dependencies",
        "type": "shell",
        "command": "pip install -r requirements.txt",
        "options": {
          "cwd": "${workspaceFolder:Backend (Python/Flask)}",
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
        },
      },
      {
        "label": "Install Frontend Dependencies",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}",
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
        },
      },
      {
        "label": "Start Flask Backend",
        "type": "shell",
        "command": "python app.py",
        "options": {
          "cwd": "${workspaceFolder:Backend (Python/Flask)}",
        },
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": "^.*$",
            "file": 1,
            "location": 2,
            "message": 3,
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": ".*Running on.*",
          },
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "group": "backend",
        },
      },
      {
        "label": "Start Angular Dev Server",
        "type": "shell",
        "command": "ng serve",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}",
        },
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": "^.*$",
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": ".*Compiled successfully.*|.*Application bundle generation complete.*",
          },
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "group": "frontend",
        },
      },
      {
        "label": "Start Full Stack",
        "dependsOn": ["Start Flask Backend", "Start Angular Dev Server"],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
        },
      },
      {
        "label": "Build Angular for Production",
        "type": "shell",
        "command": "ng build --configuration production",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}",
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new",
        },
      },
    ],
  },
}
